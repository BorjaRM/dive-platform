{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "APP_DATABASE_CONNECTION_TIMEOUT_MS",
    "APP_DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS",
    "APP_DATABASE_LOCK_TIMEOUT_MS",
    "APP_DATABASE_POOL_MAX",
    "APP_DATABASE_STATEMENT_TIMEOUT_MS",
    "APP_DATABASE_URL",
    "AUTHENTICATION_ORIGIN",
    "BFF_API_ORIGIN",
    "BFF_REQUEST_TIMEOUT_MS",
    "BFF_SERVICE_CREDENTIAL",
    "BFF_SERVICE_CREDENTIAL_VERIFIERS",
    "BOOTSTRAP_INVITATION_DELIVERY_ENABLED",
    "BOOTSTRAP_INVITATION_REDIRECT_URL",
    "BOOTSTRAP_INVITATION_WRITES_ENABLED",
    "CENTER_APP_BASE_DOMAIN",
    "CENTER_APP_BASE_ORIGIN",
    "CLERK_AUTHORIZED_PARTIES",
    "CLERK_ISSUER",
    "CLERK_REQUEST_TIMEOUT_MS",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SIGNING_SECRET",
    "DASHBOARD_CONTEXT_HMAC_SECRET",
    "DASHBOARD_CORS_ORIGINS",
    "GITHUB_EVENT_PATH",
    "NODE_ENV",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_DASHBOARD_REQUEST_TIMEOUT_MS",
    "PUBLIC_BOOKING_CAPABILITY_HMAC_SECRET",
    "PUBLIC_PRODUCT_CONTACT_EMAIL",
    "PUBLIC_PRODUCT_INDEXABLE",
    "PUBLIC_PRODUCT_ORIGIN",
    "WORKER_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
