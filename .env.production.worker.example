# Production template for the invitation worker deployment.
# Replace every placeholder before deployment. Do not use spike or local credentials.
NODE_ENV=production

WORKER_DATABASE_URL=postgres://dive_worker:replace-with-password@replace-with-production-database/dive
APP_DATABASE_POOL_MAX=4
APP_DATABASE_CONNECTION_TIMEOUT_MS=5000
APP_DATABASE_STATEMENT_TIMEOUT_MS=30000
APP_DATABASE_LOCK_TIMEOUT_MS=5000
APP_DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

CLERK_SECRET_KEY=sk_live_replace_with_clerk_secret_key
CLERK_REQUEST_TIMEOUT_MS=15000
AUTHENTICATION_ORIGIN=https://auth.replace-with-production-domain

# Delivery requires the matching writes flag to be true.
BOOTSTRAP_INVITATION_WRITES_ENABLED=false
BOOTSTRAP_INVITATION_DELIVERY_ENABLED=false
BOOTSTRAP_INVITATION_REDIRECT_URL=https://auth.replace-with-production-domain/bootstrap/accept

ORDINARY_INVITATION_WRITES_ENABLED=false
ORDINARY_INVITATION_DELIVERY_ENABLED=false
ORDINARY_INVITATION_REDIRECT_URL=https://auth.replace-with-production-domain/invitations/accept