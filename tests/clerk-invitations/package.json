    "@clerk/shared": "4.36.0",
    "@clerk/testing": "2.2.39",
    "@dive-center/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "catalog:",
    "vite": "8.3.1",
    "vitest": "^4.1.2"
  }
}
