{
  "name": "@dive-center/clerk-invitation-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project test/fixtures/clerk-invitation-react/tsconfig.json",
