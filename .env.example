# Local development and MT-SPIKE-001 integration harness only. Do not use real personal data.
# Production templates are split by service in .env.production.*.example.
NODE_ENV=development
SPIKE_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/dive_spike
SPIKE_APP_DATABASE_URL=postgres://dive_app:dive_app@127.0.0.1:55432/dive_spike
SPIKE_WORKER_DATABASE_URL=postgres://dive_worker:dive_worker@127.0.0.1:55432/dive_spike
SPIKE_PLATFORM_ADMIN_DATABASE_URL=postgres://dive_platform_admin:dive_platform_admin@127.0.0.1:55432/dive_spike
SPIKE_APP_PASSWORD=dive_app
SPIKE_MIGRATION_PASSWORD=dive_migration
SPIKE_WORKER_PASSWORD=dive_worker
SPIKE_PLATFORM_ADMIN_PASSWORD=dive_platform_admin
BOOTSTRAP_INVITATION_WRITES_ENABLED=false
BOOTSTRAP_INVITATION_DELIVERY_ENABLED=false
BOOTSTRAP_INVITATION_REDIRECT_URL=https://auth.example.test/bootstrap/accept
ORDINARY_INVITATION_WRITES_ENABLED=false
ORDINARY_INVITATION_DELIVERY_ENABLED=false
ORDINARY_INVITATION_REDIRECT_URL=https://dashboard.example.test/invitations/accept
MIGRATION_DATABASE_URL=postgres://dive_migration:dive_migration@127.0.0.1:55432/dive_spike
APP_DATABASE_URL=postgres://dive_app:dive_app@127.0.0.1:55432/dive_spike
WORKER_DATABASE_URL=postgres://dive_worker:dive_worker@127.0.0.1:55432/dive_spike
# Proposed local REL-01 values; production values require operational approval.
APP_DATABASE_POOL_MAX=4
APP_DATABASE_CONNECTION_TIMEOUT_MS=5000
APP_DATABASE_STATEMENT_TIMEOUT_MS=30000
APP_DATABASE_LOCK_TIMEOUT_MS=5000
APP_DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

# Clerk placeholders only. Replace all values outside the synthetic test harness.
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_clerk_webhook_signing_secret
CLERK_ISSUER=https://replace-with-your-clerk-instance.example
CLERK_AUTHORIZED_PARTIES=https://dashboard.example.test
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
# Proposed local REL-02 values; production values require operational approval.
CLERK_REQUEST_TIMEOUT_MS=15000
BFF_API_ORIGIN=http://localhost:3001
BFF_SERVICE_CREDENTIAL=replace-with-version-and-32-random-byte-base64url-secret
BFF_REQUEST_TIMEOUT_MS=15000
BFF_MAX_REQUEST_BODY_BYTES=1048576
BFF_MAX_RESPONSE_BODY_BYTES=8388608
NEXT_PUBLIC_DASHBOARD_REQUEST_TIMEOUT_MS=15000
DASHBOARD_CORS_ORIGINS=https://dashboard.example.test
CENTER_APP_BASE_DOMAIN=app.example.test
AUTHENTICATION_ORIGIN=https://dashboard.example.test
DASHBOARD_CONTEXT_HMAC_SECRET=replace-with-at-least-32-random-bytes
BFF_SERVICE_CREDENTIAL_VERIFIERS='[{"version":"replace-with-version","sha256":"replace-with-64-lowercase-hex-sha256"}]'
PUBLIC_BOOKING_CAPABILITY_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Public product landing. Use the production apex origin and contact destination
# in the deployment environment; keep indexing disabled for preview/non-production.
PUBLIC_PRODUCT_ORIGIN=https://bluecurrent.example
PUBLIC_PRODUCT_CONTACT_EMAIL=contact@bluecurrent.example
PUBLIC_PRODUCT_INDEXABLE=false
