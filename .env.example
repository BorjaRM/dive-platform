# Synthetic MT-SPIKE-001 harness only. Do not use real personal data.
NODE_ENV=development
SPIKE_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/dive_spike
SPIKE_APP_DATABASE_URL=postgres://dive_app:dive_app@127.0.0.1:55432/dive_spike
SPIKE_APP_PASSWORD=dive_app
SPIKE_MIGRATION_PASSWORD=dive_migration
MIGRATION_DATABASE_URL=postgres://dive_migration:dive_migration@127.0.0.1:55432/dive_spike
APP_DATABASE_URL=postgres://dive_app:dive_app@127.0.0.1:55432/dive_spike
# Proposed local REL-01 values; production values require operational approval.
APP_DATABASE_POOL_MAX=4
APP_DATABASE_CONNECTION_TIMEOUT_MS=5000
APP_DATABASE_STATEMENT_TIMEOUT_MS=30000
APP_DATABASE_LOCK_TIMEOUT_MS=5000
APP_DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

# Clerk placeholders only. Replace all values outside the synthetic test harness.
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_clerk_webhook_signing_secret
CLERK_ISSUER=https://replace-with-your-clerk-instance.example
CLERK_AUTHORIZED_PARTIES=https://dashboard.example.test
# Proposed local REL-02 values; production values require operational approval.
CLERK_REQUEST_TIMEOUT_MS=15000
NEXT_PUBLIC_DASHBOARD_REQUEST_TIMEOUT_MS=15000
DASHBOARD_CORS_ORIGINS=https://dashboard.example.test
DASHBOARD_CONTEXT_HMAC_SECRET=replace-with-at-least-32-random-bytes
