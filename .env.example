SPIKE_APP_PASSWORD=dive_app
SPIKE_MIGRATION_PASSWORD=dive_migration
SPIKE_WORKER_PASSWORD=dive_worker
SPIKE_PLATFORM_ADMIN_PASSWORD=dive_platform_admin
BOOTSTRAP_INVITATION_WRITES_ENABLED=false
BOOTSTRAP_INVITATION_DELIVERY_ENABLED=false
BOOTSTRAP_INVITATION_REDIRECT_URL=https://auth.example.test/bootstrap/accept
