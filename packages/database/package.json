  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@dive-center/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
