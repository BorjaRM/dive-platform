{
  "name": "@dive-center/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test:integration": "node --env-file=../../.env.example ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --env-file=../../.env.example --import tsx scripts/migrate.ts",
    "db:bootstrap": "node --env-file=../../.env.example --import tsx scripts/bootstrap.ts",
    "db:seed:local": "node --env-file=../../.env.example --env-file-if-exists=../../.env.local --import tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@dive-center/contracts": "workspace:*",
    "@dive-center/identity": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@dive-center/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
}
