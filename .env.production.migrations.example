# Production template for the migration job only.
# This environment must not be shared with the API or worker runtime.
NODE_ENV=production
MIGRATION_DATABASE_URL=postgres://dive_migration:replace-with-password@replace-with-production-database/dive

# db:bootstrap currently uses SPIKE_ADMIN_DATABASE_URL and is restricted to the
# local MT-SPIKE-001 harness. Do not reuse that variable for production until
# the role-provisioning connection has a production-specific contract.