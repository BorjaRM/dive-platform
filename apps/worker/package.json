  "devDependencies": {
    "@dive-center/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
