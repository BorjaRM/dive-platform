{
  "name": "@dive-center/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "swagger:local": "pnpm --filter @dive-center/api... build && node dist/local-openapi/main.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm --filter @dive-center/database build && pnpm --filter @dive-center/identity build && pnpm --filter @dive-center/observability build && node --env-file=../../.env.example ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts --no-file-parallelism",
    "test:e2e:clerk:sandbox": "pnpm --filter @dive-center/database build && pnpm --filter @dive-center/identity build && pnpm --filter @dive-center/observability build && node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.clerk.sandbox.e2e.ts",
    "test:e2e:bff:clerk:sandbox": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.bff.clerk.sandbox.e2e.ts"
  },
  "dependencies": {
    "@dive-center/contracts": "workspace:*",
    "@dive-center/database": "workspace:*",
    "@dive-center/identity": "workspace:*",
    "@dive-center/observability": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "drizzle-orm": "^0.45.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@clerk/backend": "3.20.1",
    "@dive-center/typescript-config": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
}
