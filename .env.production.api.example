# Production template for the NestJS API deployment.
# Replace every placeholder before deployment. Do not use spike or local credentials.
NODE_ENV=production

APP_DATABASE_URL=postgres://dive_app:replace-with-password@replace-with-production-database/dive
APP_DATABASE_POOL_MAX=4
APP_DATABASE_CONNECTION_TIMEOUT_MS=5000
APP_DATABASE_STATEMENT_TIMEOUT_MS=30000
APP_DATABASE_LOCK_TIMEOUT_MS=5000
APP_DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

CLERK_SECRET_KEY=sk_live_replace_with_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_clerk_webhook_signing_secret
CLERK_ISSUER=https://replace-with-clerk-issuer
CLERK_AUTHORIZED_PARTIES=https://auth.replace-with-production-domain
CLERK_REQUEST_TIMEOUT_MS=15000

BFF_SERVICE_CREDENTIAL_VERIFIERS='[{"version":"replace-with-version","sha256":"replace-with-64-lowercase-hex-sha256"}]'

CENTER_APP_BASE_DOMAIN=app.replace-with-production-domain
AUTHENTICATION_ORIGIN=https://auth.replace-with-production-domain
# Optional in production; defaults to https://CENTER_APP_BASE_DOMAIN.
# CENTER_APP_BASE_ORIGIN=https://app.replace-with-production-domain
DASHBOARD_CORS_ORIGINS=https://dashboard.replace-with-production-domain
DASHBOARD_CONTEXT_HMAC_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BOOKING_CAPABILITY_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Enable only for an approved bootstrap invitation rollout.
BOOTSTRAP_INVITATION_WRITES_ENABLED=false