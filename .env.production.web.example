# Production template for the Next.js web deployment.
# Replace every placeholder before deployment. Keep server-only values out of NEXT_PUBLIC_*.
NODE_ENV=production

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_clerk_publishable_key

BFF_API_ORIGIN=https://api.replace-with-production-domain
BFF_SERVICE_CREDENTIAL=replace-with-version-and-32-random-byte-base64url-secret
BFF_REQUEST_TIMEOUT_MS=15000
BFF_MAX_REQUEST_BODY_BYTES=1048576
BFF_MAX_RESPONSE_BODY_BYTES=8388608
NEXT_PUBLIC_DASHBOARD_REQUEST_TIMEOUT_MS=15000

# Both hosts must share a root domain; Clerk satellites are development-only.
CENTER_APP_BASE_DOMAIN=app.replace-with-production-domain
AUTHENTICATION_ORIGIN=https://auth.replace-with-production-domain
# Optional in production; defaults to https://CENTER_APP_BASE_DOMAIN.
# CENTER_APP_BASE_ORIGIN=https://app.replace-with-production-domain

PUBLIC_PRODUCT_ORIGIN=https://replace-with-production-domain
PUBLIC_PRODUCT_CONTACT_EMAIL=contact@replace-with-production-domain
PUBLIC_PRODUCT_INDEXABLE=false