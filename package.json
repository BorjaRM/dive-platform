{
  "name": "dive-center-platform",
  "private": true,
  "description": "Plataforma SaaS multi-tenant para reservas y gesti\u00f3n operativa de centros de buceo.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": ". \"${NVM_DIR:-$HOME/.nvm}/nvm.sh\" && nvm use --silent && node --env-file=.env.example ./node_modules/turbo/bin/turbo run dev",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "check-types": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check . && turbo run typecheck",
    "check:fix": "biome check --write .",
    "test:spec-governance": "node --test scripts/validate-spec-governance.test.mjs",
    "test:integration": "pnpm --filter @dive-center/database test:integration && pnpm --filter @dive-center/api test:e2e",
    "db:bootstrap": "pnpm --filter @dive-center/database db:bootstrap",
    "db:migrate": "pnpm --filter @dive-center/database db:migrate",
    "db:generate": "pnpm --filter @dive-center/database db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@dive-center/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.6.0"
}
