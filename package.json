{
  "name": "dive-center-platform",
  "private": true,
  "description": "Plataforma SaaS multi-tenant para reservas y gestión operativa de centros de buceo.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "check-types": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check . && turbo run typecheck",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@dive-center/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.6.0",
  "pnpm": {
    "overrides": {
      "typescript": "7.0.2"
    }
  }
}
